@{ Layout = null; ViewBag.Title = "Đăng nhập Admin"; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập quản trị - TẮC TẮC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&amp;family=Nunito:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/admin.css")" rel="stylesheet" />
</head>
<body class="admin-login">
    <main class="login-panel">
        <section class="login-brand">
            <div class="login-logo-mark" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="25" cy="26" r="14" /><path d="M26 11c4-6 11-6 15-2-3 6-8 9-15 8z" /><path d="M14 30c4-5 9-7 15-7-1 6-5 11-11 13z" /></svg></div>
            <h1>TẮC <span>TẮC</span><br /><small>Food Management</small></h1>
            <p class="mb-0">Không gian quản trị menu, đơn hàng và căn bếp gọn gàng, trực quan.</p>
        </section>
        <section class="login-form">
            <div class="topbar-eyebrow">Khu vực quản trị</div>
            <h2 class="mb-2">Chào mừng trở lại</h2>
            <p class="text-muted mb-4">Đăng nhập để tiếp tục quản lý cửa hàng.</p>
            @if (ViewBag.Loi != null) { <div class="alert alert-danger">@ViewBag.Loi</div> }
            @using (Html.BeginForm("DangNhap", "Account", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3"><label class="form-label">Tên đăng nhập</label><input name="tenDN" class="form-control" placeholder="Nhập tên đăng nhập" required autofocus /></div>
                <div class="mb-4"><label class="form-label">Mật khẩu</label><input name="matKhau" type="password" class="form-control" placeholder="Nhập mật khẩu" required /></div>
                <button class="btn btn-warning w-100 py-2">Đăng nhập <i class="fa-solid fa-arrow-right ms-1"></i></button>
            }
            <div class="small text-muted text-center mt-4 pt-3 border-top">Tài khoản mẫu: <b>admin / 123456</b></div>
        </section>
    </main>
</body>
</html>
