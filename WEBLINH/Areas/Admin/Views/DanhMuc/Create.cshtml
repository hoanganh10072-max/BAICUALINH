@model WEBLINH.Models.DanhMuc
@{ ViewBag.Title = "Thêm danh mục"; }

<h4>Thêm danh mục mới</h4>
<div class="card">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                @Html.LabelFor(m => m.TenDM, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.TenDM, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TenDM, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.MoTa, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })
            </div>
            <button class="btn btn-warning">Lưu</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
        }
    </div>
</div>
