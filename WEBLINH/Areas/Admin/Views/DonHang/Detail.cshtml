@model WEBLINH.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaDH;
    var trangThaiList = new[] {
        "Chờ thanh toán", "Đã chuyển khoản", "Đã xác nhận",
        "Đang giao", "Hoàn thành", "Đã hủy"
    };
}

<h4>Chi tiết đơn hàng #@Model.MaDH</h4>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light fw-bold">Thông tin đơn hàng</div>
            <div class="card-body">
                <p><b>Ngày đặt:</b> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                <p><b>Khách hàng:</b> @Model.TenNguoiDat (MaND=@Model.MaND)</p>
                <p><b>Tổng tiền:</b> <span class="text-danger fs-5 fw-bold">@Model.TongTien.ToString("N0") đ</span></p>
                <p><b>Trạng thái hiện tại:</b> <span class="badge bg-info">@Model.TrangThai</span></p>
                <hr />
                @using (Html.BeginForm("CapNhatTrangThai", "DonHang", new { area = "Admin" }, FormMethod.Post, new { @class = "d-flex gap-2" }))
                {
                    <input type="hidden" name="id" value="@Model.MaDH" />
                    <select name="trangThai" class="form-select">
                        @foreach (var t in trangThaiList)
                        {
                            <option value="@t" selected="@(t == Model.TrangThai)">@t</option>
                        }
                    </select>
                    <button class="btn btn-warning">Cập nhật</button>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light fw-bold">Giao đến</div>
            <div class="card-body">
                <p><b>Họ tên:</b> @Model.HoTenNhan</p>
                <p><b>SĐT:</b> @Model.SDTNhan</p>
                <p><b>Địa chỉ:</b> @Model.DiaChiGiao</p>
                <p><b>Ghi chú:</b> @Model.GhiChu</p>
            </div>
        </div>
    </div>
</div>

<!-- BILL CHUYEN KHOAN -->
<div class="card mt-3">
    <div class="card-header bg-success text-white fw-bold">
        <i class="fa fa-receipt"></i> Bill chuyển khoản
    </div>
    <div class="card-body text-center">
        @if (!string.IsNullOrEmpty(Model.AnhBill))
        {
            <a href="@Url.Content("~/Content/bills/" + Model.AnhBill)" target="_blank">
                <img src="@Url.Content("~/Content/bills/" + Model.AnhBill)"
                     alt="Bill" style="max-height:400px;" class="img-fluid rounded shadow-sm" />
            </a>
            <div class="mt-2">
                <a href="@Url.Content("~/Content/bills/" + Model.AnhBill)" target="_blank"
                   class="btn btn-sm btn-outline-primary">
                    <i class="fa fa-search-plus"></i> Xem ảnh gốc
                </a>
            </div>
        }
        else
        {
            <div class="text-muted py-4">
                <i class="fa fa-image fa-3x"></i>
                <p class="mt-2">Khách hàng chưa tải lên bill chuyển khoản.</p>
            </div>
        }
    </div>
</div>

<h5 class="mt-4">Sản phẩm</h5>
<table class="table">
    <thead class="table-light">
        <tr><th>Ảnh</th><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
    </thead>
    <tbody>
        @foreach (var ct in Model.ChiTiet)
        {
            <tr>
                <td><img src="@Url.Content("~/Content/uploads/" + (string.IsNullOrEmpty(ct.Anh) ? "no-image.png" : ct.Anh))" width="60" /></td>
                <td>@ct.TenSP</td>
                <td>@ct.SoLuong</td>
                <td>@ct.DonGia.ToString("N0")</td>
                <td class="fw-bold">@ct.ThanhTien.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
<a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Quay lại</a>
