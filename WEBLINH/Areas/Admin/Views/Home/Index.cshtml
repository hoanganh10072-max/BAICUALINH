@{ ViewBag.Title = "Dashboard"; }

<div class="row g-3 g-xl-4">
    <div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-icon"><i class="fa-solid fa-bag-shopping"></i></span><small>Tổng đơn hàng</small><strong>@ViewBag.SoDonHang</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="metric-card blue"><span class="metric-icon"><i class="fa-solid fa-drumstick-bite"></i></span><small>Sản phẩm</small><strong>@ViewBag.SoSanPham</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="metric-card gold"><span class="metric-icon"><i class="fa-solid fa-users"></i></span><small>Khách hàng</small><strong>@ViewBag.SoNguoiDung</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="metric-card coral"><span class="metric-icon"><i class="fa-solid fa-coins"></i></span><small>Doanh thu hoàn tất</small><strong>@(((decimal)ViewBag.DoanhThu).ToString("N0")) đ</strong></div></div>
</div>

<section class="welcome-panel mt-4">
    <h2>Chào mừng trở lại với căn bếp TẮC TẮC</h2>
    <p>Theo dõi menu, cập nhật món ăn và xử lý đơn hàng từ một nơi gọn gàng. Doanh thu chỉ tính các đơn đã hoàn thành.</p>
    <div class="quick-links">
        <a href="@Url.Action("Index", "Menu", new { area = "Admin" })"><i class="fa-solid fa-bars"></i>Chỉnh menu</a>
        <a href="@Url.Action("Index", "TrangChu", new { area = "Admin" })"><i class="fa-regular fa-image"></i>Thay banner</a>
        <a href="@Url.Action("Create", "BaiViet", new { area = "Admin" })"><i class="fa-solid fa-pen"></i>Đăng bài viết</a>
        <a href="@Url.Action("Create", "SanPham", new { area = "Admin" })"><i class="fa-solid fa-plus"></i>Thêm sản phẩm</a>
        <a href="@Url.Action("Index", "DonHang", new { area = "Admin" })"><i class="fa-solid fa-list-check"></i>Xử lý đơn hàng</a>
        <a href="@Url.Action("Index", "Home", new { area = "User" })" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i>Xem cửa hàng</a>
    </div>
</section>
