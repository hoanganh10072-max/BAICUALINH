@model WEBLINH.Models.Menu
@{ ViewBag.Title = "Thêm menu"; }

<h4>Thêm menu mới</h4>
<div class="card">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                @Html.LabelFor(m => m.TenMenu, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.TenMenu, new { @class = "form-control", placeholder = "VD: Blog" })
                @Html.ValidationMessageFor(m => m.TenMenu, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Url, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Url, new { @class = "form-control", placeholder = "/User/Home/LienHe" })
                @Html.ValidationMessageFor(m => m.Url, "", new { @class = "text-danger" })
                <div class="form-text">Bắt đầu bằng <code>/</code>. Vd: <code>/</code>, <code>/User/SanPham/DanhSach</code>.</div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.ThuTu, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.ThuTu, new { @class = "form-control", type = "number" })
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">&nbsp;</label>
                    <div class="form-check mt-2">
                        @Html.CheckBoxFor(m => m.HienThi, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.HienThi, new { @class = "form-check-label" })
                    </div>
                </div>
            </div>
            <button class="btn btn-warning">Lưu</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
        }
    </div>
</div>
