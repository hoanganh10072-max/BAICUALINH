@model System.Collections.Generic.List<WEBLINH.Models.SanPham>
@{ ViewBag.Title = "Quản lý sản phẩm"; }

<div class="d-flex justify-content-between mb-3">
    <h4>Danh sách sản phẩm (@Model.Count)</h4>
    <a href="@Url.Action("Create", "SanPham", new { area = "Admin" })" class="btn btn-warning">
        <i class="fa fa-plus"></i> Thêm sản phẩm
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã</th>
                        <th>Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>SL</th>
                        <th>Nổi bật</th>
                        <th style="width:130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sp in Model)
                    {
                        <tr>
                            <td>@sp.MaSP</td>
                            <td>
                                <img src="@Url.Content("~/Content/uploads/" + (string.IsNullOrEmpty(sp.Anh) ? "no-image.png" : sp.Anh))"
                                     width="50" />
                            </td>
                            <td>@sp.TenSP</td>
                            <td>@sp.TenDM</td>
                            <td class="text-danger">@sp.Gia.ToString("N0")</td>
                            <td>@sp.SoLuong</td>
                            <td>@(sp.NoiBat ? "✔" : "")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = sp.MaSP })" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i></a>
                                <a href="@Url.Action("Delete", new { id = sp.MaSP })" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Xác nhận xóa sản phẩm?');"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
