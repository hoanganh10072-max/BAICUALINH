@{
    var admin = Session["AdminUser"] as WEBLINH.Models.NguoiDung;
    var ctx = ViewContext.RouteData.Values;
    string ctrl = ctx["controller"] as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/admin.css")" rel="stylesheet" />
</head>
<body class="admin-body">
<div class="d-flex">
    <!-- Sidebar -->
    <aside class="admin-sidebar bg-dark text-white">
        <div class="p-3 border-bottom border-secondary">
            <h4 class="mb-0"><i class="fa fa-cog"></i> Admin Panel</h4>
            <div class="small text-warning">WEBLINH Baby Shop</div>
        </div>
        <ul class="nav flex-column p-2">
            <li class="nav-item">
                <a class="nav-link text-white @(ctrl == "Home" ? "active bg-warning" : "")"
                   href="@Url.Action("Index", "Home", new { area = "Admin" })">
                    <i class="fa fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ctrl == "DanhMuc" ? "active bg-warning" : "")"
                   href="@Url.Action("Index", "DanhMuc", new { area = "Admin" })">
                    <i class="fa fa-tags"></i> Danh mục
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ctrl == "Menu" ? "active bg-warning" : "")"
                   href="@Url.Action("Index", "Menu", new { area = "Admin" })">
                    <i class="fa fa-bars"></i> Menu điều hướng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ctrl == "SanPham" ? "active bg-warning" : "")"
                   href="@Url.Action("Index", "SanPham", new { area = "Admin" })">
                    <i class="fa fa-box"></i> Sản phẩm
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ctrl == "DonHang" ? "active bg-warning" : "")"
                   href="@Url.Action("Index", "DonHang", new { area = "Admin" })">
                    <i class="fa fa-file-invoice"></i> Đơn hàng
                </a>
            </li>
            <li class="nav-item mt-3">
                <a class="nav-link text-white-50" href="@Url.Action("Index", "Home", new { area = "User" })" target="_blank">
                    <i class="fa fa-external-link-alt"></i> Xem trang bán hàng
                </a>
            </li>
        </ul>
    </aside>

    <!-- Content -->
    <div class="admin-content flex-grow-1">
        <nav class="navbar navbar-light bg-white border-bottom shadow-sm px-3">
            <span class="navbar-text fw-bold">@ViewBag.Title</span>
            <div>
                @if (admin != null)
                {
                    <span class="me-3"><i class="fa fa-user-shield"></i> @admin.HoTen</span>
                    <a href="@Url.Action("DangXuat", "Account", new { area = "Admin" })" class="btn btn-sm btn-outline-danger">
                        <i class="fa fa-sign-out-alt"></i> Đăng xuất
                    </a>
                }
            </div>
        </nav>
        <div class="p-4">
            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Msg"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
