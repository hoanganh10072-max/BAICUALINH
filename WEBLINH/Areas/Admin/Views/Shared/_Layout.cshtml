@{
    var admin = Session["AdminUser"] as WEBLINH.Models.NguoiDung;
    var ctx = ViewContext.RouteData.Values;
    string ctrl = ctx["controller"] as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - TẮC TẮC Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&amp;family=Nunito:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/admin.css")" rel="stylesheet" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="admin-brand">
                <span class="admin-brand-mark" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="25" cy="26" r="14" /><path d="M26 11c4-6 11-6 15-2-3 6-8 9-15 8z" /><path d="M14 30c4-5 9-7 15-7-1 6-5 11-11 13z" /></svg></span>
                <div><b>TẮC <span>TẮC</span></b><small>Food Management</small></div>
            </a>
            <div class="sidebar-label">Tổng quan</div>
            <nav class="sidebar-nav">
                <a class="@(ctrl == "Home" ? "active" : "")" href="@Url.Action("Index", "Home", new { area = "Admin" })"><i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span></a>
            </nav>
            <div class="sidebar-label">Quản lý cửa hàng</div>
            <nav class="sidebar-nav">
                <a class="@(ctrl == "DanhMuc" ? "active" : "")" href="@Url.Action("Index", "DanhMuc", new { area = "Admin" })"><i class="fa-solid fa-layer-group"></i><span>Danh mục</span></a>
                <a class="@(ctrl == "Menu" ? "active" : "")" href="@Url.Action("Index", "Menu", new { area = "Admin" })"><i class="fa-solid fa-bars-staggered"></i><span>Menu điều hướng</span></a>
                <a class="@(ctrl == "TrangChu" ? "active" : "")" href="@Url.Action("Index", "TrangChu", new { area = "Admin" })"><i class="fa-regular fa-image"></i><span>Banner trang chủ</span></a>
                <a class="@(ctrl == "BaiViet" ? "active" : "")" href="@Url.Action("Index", "BaiViet", new { area = "Admin" })"><i class="fa-regular fa-newspaper"></i><span>Bài viết</span></a>
                <a class="@(ctrl == "SanPham" ? "active" : "")" href="@Url.Action("Index", "SanPham", new { area = "Admin" })"><i class="fa-solid fa-drumstick-bite"></i><span>Sản phẩm</span></a>
                <a class="@(ctrl == "DonHang" ? "active" : "")" href="@Url.Action("Index", "DonHang", new { area = "Admin" })"><i class="fa-solid fa-bag-shopping"></i><span>Đơn hàng</span></a>
            </nav>
            <div class="sidebar-footer">
                <a href="@Url.Action("Index", "Home", new { area = "User" })" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i><span>Xem cửa hàng</span></a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <span class="topbar-eyebrow">TẮC TẮC · Chân gà nhà làm</span>
                    <h1>@ViewBag.Title</h1>
                </div>
                @if (admin != null)
                {
                    <div class="admin-user">
                        <span class="admin-avatar">@admin.HoTen.Substring(0, 1).ToUpper()</span>
                        <span class="d-none d-sm-block"><small>Quản trị viên</small><b>@admin.HoTen</b></span>
                        <a href="@Url.Action("DangXuat", "Account", new { area = "Admin" })" title="Đăng xuất"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
                    </div>
                }
            </header>
            <main class="admin-content">
                @if (TempData["Msg"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"><i class="fa-solid fa-circle-check me-2"></i>@TempData["Msg"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
