@{ ViewBag.Title = "Đơn hàng đang chờ xác nhận"; }

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0 my-5">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <i class="fa fa-hourglass-half text-warning" style="font-size:80px;"></i>
                </div>
                <h2 class="fw-bold text-warning">Đơn hàng đang chờ xác nhận</h2>
                <p class="lead mt-3">
                    Bill chuyển khoản của bạn đã được gửi thành công.
                </p>
                <p>
                    Đơn hàng <b class="text-danger fs-4">#@ViewBag.MaDH</b> đang chờ shop kiểm tra và xác nhận thanh toán.
                </p>

                <div class="alert alert-info text-start mt-4">
                    <h6 class="fw-bold mb-2"><i class="fa fa-info-circle"></i> Các bước tiếp theo</h6>
                    <ol class="mb-0">
                        <li>Shop sẽ kiểm tra bill chuyển khoản trong vòng <b>24 giờ</b>.</li>
                        <li>Sau khi xác nhận, đơn hàng sẽ được chuẩn bị và giao đến bạn.</li>
                        <li>Khi đơn được xác nhận, bạn có thể xem <b>hóa đơn mua hàng</b> tại mục "Đơn hàng của tôi".</li>
                    </ol>
                </div>

                <div class="mt-4">
                    <a href="@Url.Action("DonHangCuaToi", "TaiKhoan", new { area = "User" })" class="btn btn-warning btn-lg">
                        <i class="fa fa-list"></i> Xem đơn hàng của tôi
                    </a>
                    <a href="@Url.Action("Index", "Home", new { area = "User" })" class="btn btn-outline-secondary btn-lg">
                        <i class="fa fa-home"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
