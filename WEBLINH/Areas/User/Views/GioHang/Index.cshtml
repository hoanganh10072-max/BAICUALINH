@model System.Collections.Generic.List<WEBLINH.Models.CartItem>
@{ ViewBag.Title = "Giỏ hàng"; }

<section class="page-hero">
    <div class="section-kicker">Sẵn sàng thanh toán</div>
    <h1>Giỏ hàng của bạn</h1>
    <p>Kiểm tra lại các món ngon và số lượng trước khi gửi đơn đến căn bếp.</p>
</section>

@if (!Model.Any())
{
    <div class="content-feature text-center">
        <i class="fa-solid fa-bag-shopping mb-3" style="font-size:48px;color:var(--sage)"></i>
        <h3>Giỏ món vẫn đang trống</h3>
        <p class="text-muted">Chọn ngay một hộp sả tắc, sốt Thái hoặc combo để nhập hội ăn vui nhé.</p>
        <a href="@Url.Action("DanhSach", "SanPham", new { area = "User" })" class="btn-brand mt-2">Xem menu món ngon</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th style="width:160px">Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><div class="d-flex align-items-center gap-3"><img src="@(string.IsNullOrEmpty(item.Anh) ? Url.Content("~/Content/uploads/no-image-food.png") : Url.Content("~/Content/uploads/" + item.Anh))" width="76" height="76" alt="@item.TenSP" /><b>@item.TenSP</b></div></td>
                                <td>@item.Gia.ToString("N0") đ</td>
                                <td>
                                    @using (Html.BeginForm("CapNhat", "GioHang", new { area = "User" }, FormMethod.Post, new { @class = "d-flex gap-2" }))
                                    {
                                        <input type="hidden" name="id" value="@item.MaSP" />
                                        <input type="number" name="soLuong" value="@item.SoLuong" min="1" class="form-control form-control-sm" />
                                        <button class="btn btn-sm btn-outline-primary" title="Cập nhật"><i class="fa-solid fa-rotate"></i></button>
                                    }
                                </td>
                                <td class="fw-bold" style="color:var(--coral-dark)">@item.ThanhTien.ToString("N0") đ</td>
                                <td><a href="@Url.Action("Xoa", "GioHang", new { area = "User", id = item.MaSP })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa sản phẩm khỏi giỏ hàng?');" aria-label="Xóa"><i class="fa-regular fa-trash-can"></i></a></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th class="fs-4" style="color:var(--coral-dark)">@Model.Sum(x => x.ThanhTien).ToString("N0") đ</th><th></th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mt-4">
        <a href="@Url.Action("DanhSach", "SanPham", new { area = "User" })" class="btn-soft"><i class="fa-solid fa-arrow-left"></i> Chọn thêm món</a>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("XoaTatCa", "GioHang", new { area = "User" })" class="btn btn-outline-danger" onclick="return confirm('Xóa toàn bộ giỏ hàng?');"><i class="fa-regular fa-trash-can me-1"></i>Xóa giỏ hàng</a>
            <a href="@Url.Action("ThanhToan", "GioHang", new { area = "User" })" class="btn-brand"><i class="fa-solid fa-lock"></i>Thanh toán an toàn</a>
        </div>
    </div>
}
