@model System.Collections.Generic.List<WEBLINH.Models.CartItem>
@{ ViewBag.Title = "Giỏ hàng"; }

<h2><i class="fa fa-shopping-cart"></i> Giỏ hàng của bạn</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Giỏ hàng của bạn đang trống. <a href="@Url.Action("DanhSach", "SanPham", new { area = "User" })" class="alert-link">Mua sắm ngay</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th style="width:150px;">Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.Anh) ? Url.Content("~/Content/uploads/no-image.png") : Url.Content("~/Content/uploads/" + item.Anh))"
                                 width="70" alt="@item.TenSP" />
                        </td>
                        <td>@item.TenSP</td>
                        <td>@item.Gia.ToString("N0") đ</td>
                        <td>
                            @using (Html.BeginForm("CapNhat", "GioHang", new { area = "User" }, FormMethod.Post, new { @class = "d-flex gap-1" }))
                            {
                                <input type="hidden" name="id" value="@item.MaSP" />
                                <input type="number" name="soLuong" value="@item.SoLuong" min="1" class="form-control form-control-sm" />
                                <button class="btn btn-sm btn-outline-primary"><i class="fa fa-sync"></i></button>
                            }
                        </td>
                        <td class="fw-bold text-danger">@item.ThanhTien.ToString("N0") đ</td>
                        <td>
                            <a href="@Url.Action("Xoa", "GioHang", new { area = "User", id = item.MaSP })"
                               class="btn btn-sm btn-danger" onclick="return confirm('Xóa sản phẩm khỏi giỏ hàng?');">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Tổng cộng:</th>
                    <th class="fs-4 text-danger">@Model.Sum(x => x.ThanhTien).ToString("N0") đ</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="d-flex justify-content-between">
        <a href="@Url.Action("DanhSach", "SanPham", new { area = "User" })" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left"></i> Tiếp tục mua sắm
        </a>
        <div>
            <a href="@Url.Action("XoaTatCa", "GioHang", new { area = "User" })" class="btn btn-outline-danger"
               onclick="return confirm('Xóa toàn bộ giỏ hàng?');">
                <i class="fa fa-trash"></i> Xóa tất cả
            </a>
            <a href="@Url.Action("ThanhToan", "GioHang", new { area = "User" })" class="btn btn-warning btn-lg">
                <i class="fa fa-credit-card"></i> Thanh toán
            </a>
        </div>
    </div>
}
