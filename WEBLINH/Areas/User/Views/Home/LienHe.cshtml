@{ ViewBag.Title = "Liên hệ"; }

<h2>Liên hệ với chúng tôi</h2>
<hr />
<div class="row g-4">
    <div class="col-md-6">
        <h5>Thông tin cửa hàng</h5>
        <p><i class="fa fa-map-marker-alt text-danger"></i> <b>Địa chỉ:</b> Số 1, Đường ABC, Quận XYZ, Hà Nội</p>
        <p><i class="fa fa-phone text-success"></i> <b>Hotline:</b> 0900 000 000</p>
        <p><i class="fa fa-envelope text-primary"></i> <b>Email:</b> weblinh@babyshop.com</p>
        <p><i class="fa fa-clock text-warning"></i> <b>Giờ mở cửa:</b> 8:00 - 22:00 tất cả các ngày</p>
    </div>
    <div class="col-md-6">
        <h5>Gửi liên hệ</h5>
        <form>
            <div class="mb-2"><input class="form-control" placeholder="Họ tên" /></div>
            <div class="mb-2"><input class="form-control" placeholder="Email" /></div>
            <div class="mb-2"><textarea class="form-control" rows="4" placeholder="Nội dung"></textarea></div>
            <button type="button" class="btn btn-warning">Gửi</button>
        </form>
    </div>
</div>
