@model WEBLINH.Models.SanPham
@{
    ViewBag.Title = Model.TenSP;
    var lienQuan = ViewBag.LienQuan as System.Collections.Generic.List<WEBLINH.Models.SanPham>;
}

<nav class="mb-3">
    <a href="@Url.Action("Index", "Home", new { area = "User" })">Trang chủ</a> /
    <a href="@Url.Action("DanhSach", "SanPham", new { area = "User", maDM = Model.MaDM })">@Model.TenDM</a> /
    <span>@Model.TenSP</span>
</nav>

<div class="row g-4">
    <div class="col-md-5">
        <img src="@(string.IsNullOrEmpty(Model.Anh) ? Url.Content("~/Content/uploads/no-image.png") : Url.Content("~/Content/uploads/" + Model.Anh))"
             class="img-fluid rounded shadow-sm" alt="@Model.TenSP" />
    </div>
    <div class="col-md-7">
        <h2>@Model.TenSP</h2>
        <p class="text-muted">Danh mục: <a href="@Url.Action("DanhSach", "SanPham", new { area = "User", maDM = Model.MaDM })">@Model.TenDM</a></p>
        <div class="text-danger fs-2 fw-bold mb-3">@Model.Gia.ToString("N0") đ</div>
        <p>Còn lại: <b>@Model.SoLuong</b> sản phẩm</p>

        @using (Html.BeginForm("Them", "GioHang", new { area = "User" }, FormMethod.Get, new { @class = "mb-3" }))
        {
            <input type="hidden" name="id" value="@Model.MaSP" />
            <div class="d-flex align-items-center gap-2 mb-3" style="max-width:300px;">
                <label>Số lượng:</label>
                <input type="number" name="soLuong" value="1" min="1" max="@Model.SoLuong" class="form-control" />
            </div>
            <button type="submit" class="btn btn-warning btn-lg">
                <i class="fa fa-cart-plus"></i> Thêm vào giỏ hàng
            </button>
            <a href="@Url.Action("Index", "GioHang", new { area = "User" })" class="btn btn-outline-secondary btn-lg">
                <i class="fa fa-shopping-cart"></i> Xem giỏ hàng
            </a>
        }
    </div>
</div>

<hr class="my-4" />
<h4>Mô tả sản phẩm</h4>
<div>@Html.Raw(Model.MoTa)</div>

@if (lienQuan != null && lienQuan.Any())
{
    <hr class="my-4" />
    <h4>Sản phẩm liên quan</h4>
    <div class="row g-3">
        @foreach (var sp in lienQuan.Where(x => x.MaSP != Model.MaSP).Take(4))
        {
            <div class="col-md-3 col-6">
                @Html.Partial("_ProductCard", sp)
            </div>
        }
    </div>
}
