@{
    var danhMucMenu = ViewBag.DanhMuc as System.Collections.Generic.List<WEBLINH.Models.DanhMuc>;
    var currentUser = Session["User"] as WEBLINH.Models.NguoiDung;
    var cart = Session["Cart"] as System.Collections.Generic.List<WEBLINH.Models.CartItem>;
    int soLuongCart = cart == null ? 0 : cart.Count;
    var mainMenu = WEBLINH.Models.MenuDAO.GetVisible();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - WEBLINH Baby Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/site.css")" rel="stylesheet" />
</head>
<body>
    <!-- Top bar -->
    <div class="topbar bg-dark text-white py-2 small">
        <div class="container d-flex justify-content-between">
            <span><i class="fa fa-phone"></i> Hotline: 0900 000 000</span>
            <span>
                @if (currentUser != null)
                {
                    <a href="@Url.Action("ThongTin", "TaiKhoan", new { area = "User" })" class="text-white me-3">
                        <i class="fa fa-user"></i> @currentUser.HoTen
                    </a>
                    <a href="@Url.Action("DonHangCuaToi", "TaiKhoan", new { area = "User" })" class="text-white me-3">Đơn hàng</a>
                    <a href="@Url.Action("DangXuat", "TaiKhoan", new { area = "User" })" class="text-white">Đăng xuất</a>
                }
                else
                {
                    <a href="@Url.Action("DangNhap", "TaiKhoan", new { area = "User" })" class="text-white me-3">Đăng nhập</a>
                    <a href="@Url.Action("DangKy", "TaiKhoan", new { area = "User" })" class="text-white">Đăng ký</a>
                }
            </span>
        </div>
    </div>

    <!-- Header -->
    <header class="bg-pink py-3">
        <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
            <a href="@Url.Action("Index", "Home", new { area = "User" })" class="logo text-decoration-none">
                <span class="fs-3 fw-bold text-white">WEB<span class="text-warning">LINH</span></span>
                <div class="text-white small">Baby Shop - Quần áo trẻ sơ sinh</div>
            </a>
            <form action="@Url.Action("TimKiem", "SanPham", new { area = "User" })" method="get" class="d-flex flex-grow-1 mx-md-4" style="max-width:500px;">
                <input type="text" name="kw" class="form-control" placeholder="Tìm sản phẩm..." value="@ViewBag.Keyword" />
                <button class="btn btn-warning" type="submit"><i class="fa fa-search"></i></button>
            </form>
            <a href="@Url.Action("Index", "GioHang", new { area = "User" })" class="btn btn-light position-relative">
                <i class="fa fa-shopping-cart"></i> Giỏ hàng
                <span class="badge bg-danger rounded-pill">@soLuongCart</span>
            </a>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav">
                    @foreach (var mi in mainMenu)
                    {
                        <li class="nav-item"><a class="nav-link" href="@mi.Url">@mi.TenMenu</a></li>
                    }
                    @if (danhMucMenu != null && danhMucMenu.Count > 0)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Danh mục</a>
                            <ul class="dropdown-menu">
                                @foreach (var dm in danhMucMenu)
                                {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DanhSach", "SanPham", new { area = "User", maDM = dm.MaDM })">@dm.TenDM</a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Content -->
    <main class="container my-4">
        @if (TempData["Msg"] != null)
        {
            <div class="alert alert-success">@TempData["Msg"]</div>
        }
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>WEBLINH Baby Shop</h5>
                    <p>Chuyên cung cấp quần áo cho trẻ sơ sinh chất lượng, an toàn, giá tốt.</p>
                </div>
                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <p><i class="fa fa-map-marker-alt"></i> Số 1, Đường ABC, Hà Nội</p>
                    <p><i class="fa fa-phone"></i> 0900 000 000</p>
                    <p><i class="fa fa-envelope"></i> weblinh@babyshop.com</p>
                </div>
                <div class="col-md-4">
                    <h5>Chính sách</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50">Chính sách vận chuyển</a></li>
                        <li><a href="#" class="text-white-50">Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-white-50">Bảo mật thông tin</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <div class="text-center small">© @DateTime.Now.Year WEBLINH Baby Shop.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
