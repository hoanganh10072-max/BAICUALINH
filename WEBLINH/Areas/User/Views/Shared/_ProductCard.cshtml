@model WEBLINH.Models.SanPham
<article class="card product-card">
    <a href="@Url.Action("ChiTiet", "SanPham", new { area = "User", id = Model.MaSP })" class="product-media">
        @if (Model.NoiBat)
        {
            <span class="product-badge">Nổi bật</span>
        }
        <img src="@(string.IsNullOrEmpty(Model.Anh) ? Url.Content("~/Content/uploads/no-image-food.png") : Url.Content("~/Content/uploads/" + Model.Anh))"
             alt="@Model.TenSP" loading="lazy" />
        <span class="quick-view" aria-hidden="true"><i class="fa-regular fa-eye"></i></span>
    </a>
    <div class="card-body d-flex flex-column">
        <div class="product-category">TẮC TẮC · TRỘN TƯƠI</div>
        <h3 class="product-title">
            <a href="@Url.Action("ChiTiet", "SanPham", new { area = "User", id = Model.MaSP })">@Model.TenSP</a>
        </h3>
        <div class="product-bottom mt-auto">
            <div class="product-price">@Model.Gia.ToString("N0") đ</div>
            <a href="@Url.Action("Them", "GioHang", new { area = "User", id = Model.MaSP })" class="add-cart-btn" title="Thêm vào giỏ hàng" aria-label="Thêm @Model.TenSP vào giỏ hàng"><i class="fa-solid fa-bag-shopping"></i></a>
        </div>
    </div>
</article>
