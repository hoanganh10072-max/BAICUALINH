@model WEBLINH.Models.NguoiDung
@{ ViewBag.Title = "Thông tin tài khoản"; }

<h2>Thông tin tài khoản</h2>
<hr />
<div class="row justify-content-center">
    <div class="col-md-7">
        @using (Html.BeginForm("ThongTin", "TaiKhoan", new { area = "User" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label>Tên đăng nhập</label>
                <input class="form-control" value="@Model.TenDN" readonly />
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.HoTen)
                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.SDT)
                @Html.TextBoxFor(m => m.SDT, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.DiaChi)
                @Html.TextAreaFor(m => m.DiaChi, new { @class = "form-control", rows = 3 })
            </div>
            <button class="btn btn-warning">Cập nhật</button>
        }
    </div>
</div>
